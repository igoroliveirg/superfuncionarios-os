# Copy this file to .env and fill in the values. Server-side only.
# NEVER use a VITE_ prefix on secrets — Vite inlines VITE_* into the client bundle (leaks the key).

# Anthropic API key for the niche-identification call (Haiku).
ANTHROPIC_API_KEY=

# Optional: Jina Reader key for robust scraping of JS-heavy client sites (https://jina.ai/reader).
# Leave blank to use keyless mode (lower rate limit).
JINA_API_KEY=
